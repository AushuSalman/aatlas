# ============================================================================
#  Copy to .env and fill in. .env is git-ignored.
#
#  Only DB_* matters to run locally; everything else has a working default or is
#  switched off in the `local` profile.
# ============================================================================

# --- database (required) ---------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/aatlas
DB_USER=aatlas
DB_PASSWORD=aatlas

# --- process role: api | engine-worker | ingest-worker ---------------------
AATLAS_ROLE=api

# --- JWT signing -----------------------------------------------------------
# Leave empty locally and a throwaway pair is generated at startup, which signs
# everyone out on restart. Generate a real pair with:
#   openssl genpkey -algorithm RSA -pkcs8 -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private.pem -out public.pem
JWT_ISSUER=https://api.aatlas.io
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- cache: caffeine (in-process) | redis (required for >1 pod) ------------
CACHE_MODE=caffeine
REDIS_HOST=localhost
REDIS_PORT=6379

# --- messaging (not used in the local profile) -----------------------------
KAFKA_BROKERS=localhost:9092

# --- object storage --------------------------------------------------------
S3_BUCKET=aatlas-local
AWS_REGION=us-east-1
S3_ENDPOINT=

# --- mail (signup codes, password reset, RFQ send) -------------------------
# log = print mail to the console; smtp = really send it; resend = Resend's REST API.
# Use resend, not smtp, on Render (and most PaaS hosts) - they block outbound SMTP on
# every port, to any relay, so smtp times out there regardless of provider or credentials.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@aatlas.io
MAIL_FROM_NAME=Aatlas
APP_URL=http://localhost:3000
# Example for Gmail (needs 2FA and an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_AUTH=true  SMTP_STARTTLS=true
#   SMTP_USERNAME=you@gmail.com  SMTP_PASSWORD=<16-char app password>  MAIL_FROM=you@gmail.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# MAIL_TRANSPORT=resend: an API key from resend.com/api-keys. RESEND_FROM defaults to
# Resend's own sandbox sender (onboarding@resend.dev), which needs no domain verification.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Signup requires a verified email. Only turn off for scripts and tests.
REQUIRE_EMAIL_VERIFICATION=true

# --- AI price research (pilot) ----------------------------------------------
# Web search for the "check the market" price-suggestion feature. Get a free
# key (1,000 searches/month, no card) at https://app.tavily.com - leave empty
# and the feature reports itself unavailable rather than failing.
TAVILY_API_KEY=

# --- Live competitor prices (Competition) -----------------------------------
# Any one is enough; each empty one is simply off. Kept listings are saved as
# competitor observations and become the competitor anchor in every price.
# Google Shopping via SerpApi - free plan 250 searches/month: https://serpapi.com
SERPAPI_API_KEY=
# eBay Browse API - free, 5,000 calls/day: https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Amazon via Rainforest API - paid: https://www.trajectdata.com/ecommerce/rainforest-api/
RAINFOREST_API_KEY=
# Oxylabs Web Scraper API - paid, free trial: https://oxylabs.io
# Google Shopping, and the price on each tracked competitor's own product page.
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
# DataForSEO - finds your online competitors (who ranks for your items).
# Pay as you go (~$0.01 a search, $50 minimum top-up, $1 free trial):
# https://app.dataforseo.com/api-access (API login + generated API password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Live market data (commodity moves and exchange rates) -------------------
# FRED producer price indices drive the commodity step and buy-now-vs-wait.
# Free key: https://fredaccount.stlouisfed.org/apikeys - empty keeps the seed figures.
# Exchange rates come from the ECB via Frankfurter and need no key.
FRED_API_KEY=
# false: no calls out at all (offline development).
MARKET_DATA_ENABLED=true
# Local settings. Git-ignored - never commit this file.

# --- behaviour -------------------------------------------------------------
# Freeze "now" at 1 Sep 2026 to match the prototype's seeded story.
CLOCK_FIXED=false
# Row-level security: leave off until the tenant tables and policies exist.
RLS_ENABLED=false
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=DEBUG
TRACE_SAMPLE_RATE=1.0
