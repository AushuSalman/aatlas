# ============================================================================
#  Copy to .env and fill in. .env is git-ignored.
#
#  Only DB_* matters to run locally; everything else has a working default or is
#  switched off in the `local` profile.
# ============================================================================

# --- database (required) ---------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/aatlas
DB_USER=aatlas
DB_PASSWORD=aatlas

# --- process role: api | engine-worker | ingest-worker ---------------------
AATLAS_ROLE=api

# --- JWT signing -----------------------------------------------------------
# Leave empty locally and a throwaway pair is generated at startup, which signs
# everyone out on restart. Generate a real pair with:
#   openssl genpkey -algorithm RSA -pkcs8 -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private.pem -out public.pem
JWT_ISSUER=https://api.aatlas.io
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- cache: caffeine (in-process) | redis (required for >1 pod) ------------
CACHE_MODE=caffeine
REDIS_HOST=localhost
REDIS_PORT=6379

# --- messaging (not used in the local profile) -----------------------------
KAFKA_BROKERS=localhost:9092

# --- object storage --------------------------------------------------------
S3_BUCKET=aatlas-local
AWS_REGION=us-east-1
S3_ENDPOINT=

# --- mail (RFQ send) -------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025

# --- behaviour -------------------------------------------------------------
# Freeze "now" at 1 Sep 2026 to match the prototype's seeded story.
CLOCK_FIXED=false
# Row-level security: leave off until the tenant tables and policies exist.
RLS_ENABLED=false
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=DEBUG
TRACE_SAMPLE_RATE=1.0
